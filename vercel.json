{
  "redirects": [
    {
      "source": "/film/en",
      "destination": "/film?lang=en",
      "permanent": false
    },
    {
      "source": "/film/short/en",
      "destination": "/film/short?lang=en",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/film",
      "destination": "/film/index.html"
    },
    {
      "source": "/film/short",
      "destination": "/film/short/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/register/",
      "destination": "/index.html"
    },
    {
      "source": "/grievance",
      "destination": "/index.html"
    },
    {
      "source": "/grievance/",
      "destination": "/index.html"
    },
    {
      "source": "/grievances",
      "destination": "/index.html"
    },
    {
      "source": "/grievances/",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "45 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/film/hls-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/film/mark.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/film/og-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
