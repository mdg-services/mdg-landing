{
  "name": "mdg-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run film",
    "dev": "next dev --webpack --port 5180",
    "prebuild": "npm run film && npm run guide -- check",
    "build": "next build --webpack",
    "start": "next start --port 5180",
    "film": "esbuild scripts/film-build.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/film-build.mjs --log-level=warning && node node_modules/.cache/film-build.mjs",
    "typecheck": "tsc --noEmit",
    "check:enroll": "npx tsx --test scripts/enroll.check.ts",
    "email:preview": "esbuild scripts/render-emails.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/render-emails.mjs && node node_modules/.cache/render-emails.mjs",
    "logos:gen": "node scripts/gen-logos.mjs",
    "lint": "eslint .",
    "review": "node scripts/review.mjs",
    "og": "node scripts/og.mjs",
    "og:film": "node scripts/og-film.mjs",
    "guide": "esbuild scripts/guide-cli.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/guide-cli.mjs --log-level=warning && node node_modules/.cache/guide-cli.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "marked": "^18.0.13",
    "next": "16.3.8",
    "nodemailer": "^9.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^24.12.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
