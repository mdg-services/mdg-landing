# ── Email (dealer enrolment) — SMTP ──────────────────────────────────────
# Provider-agnostic SMTP. Defaults target Hostinger email.
#
# To get these for a Hostinger mailbox (e.g. noreply@mdgservices.in):
#   1. hPanel → Emails → Email Accounts (for the mdgservices.in domain).
#   2. Create the mailbox "noreply@mdgservices.in" and set a password
#      (or "Change password" on an existing one).
#   3. SMTP_USER is the full address; SMTP_PASS is that mailbox password.
#      (Hostinger has no separate "app password" — it's the mailbox password.)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465            # 465 = SSL (SMTP_SECURE=true). Use 587 + SMTP_SECURE=false for STARTTLS.
SMTP_SECURE=true
SMTP_USER=noreply@mdgservices.in
SMTP_PASS=your-mailbox-password

# "From" header. Defaults to SMTP_USER; name is cosmetic.
MAIL_FROM=noreply@mdgservices.in
MAIL_FROM_NAME=MDG Services

# Where internal enrolment notifications land.
ENROLLMENT_NOTIFY_TO=mdgservicesterms@gmail.com

# ── Hand-off to the MDG API (grievances and registrations) ────────────────
# After validating a form, this site's server also sends it to the MDG API so
# it shows on the admin panel's Grievances and Registrations pages. The secret
# must be EXACTLY the value of WEBSITE_INTAKE_SECRET on the backend.
# Make it with:  openssl rand -hex 32   (64 characters; the backend needs at
# least 32).
# On Vercel set it for the Production environment ONLY. Preview deployments
# then have none and fail closed: they refuse grievances and flag registrations
# "[not on admin list]" in the team's email, and never write into the live
# admin list.
# Without it: production refuses grievances (and logs it), enrolments still
# email the team; locally the hand-off is logged instead of sent.
WEBSITE_INTAKE_SECRET=replace-with-the-64-characters-from-openssl-rand-hex-32
# Optional. Default: https://api.mdgservices.in/api/v1
# MDG_API_URL=http://localhost:4000/api/v1

# Notes:
# - Set these in Vercel → Project → Settings → Environment Variables for prod.
# - Locally, copy this file to `.env` (or `.env.local`). Without credentials the
#   dev server logs emails to the terminal instead of sending, so the form
#   still works for testing.

# ── Assistant widget (ADR 0009) ──────────────────────────────────────────
# Where the assistant talks to. Baked into the bundle at build time, so it is
# public by design: it is the same API address the browser would show in its
# network tab. Leave it unset in production; the default below is what ships.
#
#   default: https://api.mdgservices.in/api/v1
#
# Set it only to point a local build at a backend running on this machine:
# VITE_ASSIST_API_BASE=http://localhost:4000/api/v1
